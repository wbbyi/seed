.modal-mask.data-v-07e72d3c {
		display: flex;
		flex-direction: column;
		position: fixed;
		gap: 20rpx;
		/* 固定定位 */
		top: 50%;
		/* 顶部 50% */
		left: 50%;
		/* 左侧 50% */
		transform: translate(-50%, -50%);
		/* 偏移自身宽高的一半实现居中 */
		width: 600rpx;
		/* 你想要的固定宽度 */
		max-height: 45vh;
		/* 控制最大高度，防止溢出 */
		background: #fff;
		border-radius: 16rpx;
		padding: 20rpx;
		z-index: 999;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}
